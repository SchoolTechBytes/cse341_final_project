PORT=the_port_you_want_to_run_on
MONGODB_URI=CONNECTION_STRING_TO_DATABASE
SESSION_SECRET=VERY_LONG_STRING_OF_RANDOM_CHARS
GITHUB_CLIENT_ID=your_actual_client_id_here
GITHUB_CLIENT_SECRET=your_actual_client_secret_here
GITHUB_CALLBACK_URL=Authorization_callback_URL (e.g., http://localhost:3000/api/auth/callback/github)
NODE_ENV=SOFTWARE_DEPLOYMENT_ENVIRONMENT
CORS_ORIGIN=Comma_separated_list_of_allowed_origins (e.g., http://localhost:3000,http://localhost:5173)